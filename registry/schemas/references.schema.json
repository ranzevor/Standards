{
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "line",
      "url",
      "kind",
      "label",
      "document_id",
      "path"
    ],
    "additionalProperties": true,
    "properties": {
      "line": {
        "type": "integer"
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "inline",
          "reference",
          "definition",
          "literal-path",
          "citation"
        ]
      },
      "label": {
        "type": "string"
      },
      "document_id": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "citation_source_path": {
        "type": "string",
        "minLength": 1
      },
      "citation_source_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "citation_declaration_line": {
        "type": "integer"
      },
      "citation_declaration_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
