{
  "type": "array",
  "minItems": 162,
  "maxItems": 162,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "path",
      "domain",
      "version",
      "status",
      "language",
      "effective_date",
      "sha256"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^STD-(?:L[0-6](?:-[A-Z0-9]+)*|PG)-[0-9]{3}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^standards/(?:[^/]+/)*[0-9]{3}-[^/]+--v0\\.1\\.(0|[1-9][0-9]*)\\.md$"
      },
      "domain": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "pattern": "^0\\.1\\.(0|[1-9][0-9]*)$"
      },
      "status": {
        "enum": [
          "adopted"
        ]
      },
      "language": {
        "enum": [
          "zh-Hans"
        ]
      },
      "effective_date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
